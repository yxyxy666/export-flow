# make infra首次自动生成.env.infrastructure.local并替换密码占位符，无需手工复制。
# 本地生成文件不提交Git；已有数据卷不会因修改密码而重置账号。
EXPORT_FLOW_MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>
EXPORT_FLOW_DB_PASSWORD=<DB_PASSWORD>
EXPORT_FLOW_MIGRATOR_PASSWORD=<MIGRATOR_PASSWORD>
EXPORT_FLOW_RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>
EXPORT_FLOW_MYSQL_PORT=3306
EXPORT_FLOW_REDIS_PORT=6379
EXPORT_FLOW_RABBITMQ_PORT=5672
EXPORT_FLOW_RABBITMQ_MANAGEMENT_PORT=15672

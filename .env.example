# make infra自动生成或同步.env.local连接字段；已有文件修改前备份，其他设置保留。
# .env.local 已被 Git 忽略；Make/PowerShell 入口读取该文件，直接 java 不读取。
# make infra创建本项目专用Compose及初始化资源；然后用make dev启动应用。
# 新建容器凭据保存在.env.infrastructure.local；本文件只配应用连接。
# 后端与Vite代理共用此端口；若8080被其他应用占用，两端一同改为可用端口。
EXPORT_FLOW_BACKEND_PORT=8080

# MySQL：任务存储在export_flow，订单只读exportflow.orders（全新环境初始化为空表）。
EXPORT_FLOW_JDBC_URL=jdbc:mysql://127.0.0.1:3306/export_flow?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8&rewriteBatchedStatements=true
EXPORT_FLOW_DB_USER=export_flow_app
EXPORT_FLOW_DB_PASSWORD=<运行密码>
# Flyway 使用独立账号，只迁移应用库，不改写来源订单。
SPRING_FLYWAY_USER=export_flow_migrator
SPRING_FLYWAY_PASSWORD=<迁移密码>

# URI 中的账号、密码需按 URL 编码；此处不追加 vhost 路径。
# 后端 spring.rabbitmq.virtual-host 已固定为 /export-flow。
EXPORT_FLOW_AMQP_URL=amqp://export_flow_mq:<MQ密码>@127.0.0.1:5672
EXPORT_FLOW_MANAGEMENT_URL=http://127.0.0.1:15672

# 每个同时运行的 API 实例使用独立且跨重启稳定的标识。
EXPORT_FLOW_INSTANCE_ID=local-api
EXPORT_FLOW_PROGRESS_ENABLED=true
# Redis 为可降级进度缓存；不影响 MySQL 权威任务记录。
EXPORT_FLOW_REDIS_HOST=127.0.0.1
EXPORT_FLOW_REDIS_PORT=6379
EXPORT_FLOW_REDIS_USER=
EXPORT_FLOW_REDIS_PASSWORD=

# 导出文件和断点统一存放在当前项目根目录的 export-data，Git 忽略此运行目录。
# 标准启动入口固定在项目根目录，未配置此项时自动使用项目根目录/export-data。
# 若需自定义位置，请设置绝对路径，例如：
# EXPORT_FLOW_FILE_ROOT=D:/path/to/export-flow/export-data
# 日志仍默认位于 LOCALAPPDATA/ExportFlow/logs，可另行设置绝对路径：
# EXPORT_FLOW_LOG_FILE=D:/export-flow/logs/export-flow.log
